# Local preview is always the default. Live checkout intentionally fails closed.
STORE_MODE=demo
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Exact public origin for production or a reverse proxy, e.g. https://hello.example
# Leave blank for local development loopback aliases at the same port.
STORE_ORIGIN=

# Optional future Supabase catalog/auth connection. Never enter secrets here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only future production integration; never prefix with NEXT_PUBLIC_.
# Current app does not take live orders even when these values are configured.
SUPABASE_SERVICE_ROLE_KEY=

# No payment or email provider is enabled. Add approved integrations only after
# verification, sandbox tests, privacy/retention setup, and owner approval.

# Firebase web configuration is public. Only Firebase Authentication is used here.
# Firebase Admin credentials and the allowlist are SERVER ONLY. Add through Vercel env.
FIREBASE_PROJECT_ID=hello-clothing
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Comma-separated Firebase Auth UIDs for staff allowed to use /admin. Blank DENIES ALL.
HELLO_ADMIN_UIDS=
